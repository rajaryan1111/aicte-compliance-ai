# Frontend configuration.
# Leave VITE_API_BASE_URL empty in local dev: requests go to /api and the Vite
# dev server proxies them to the backend (see vite.config.ts). Set it only when
# the UI is served from a different origin than the API.
VITE_API_BASE_URL=
# Backend origin used by the dev proxy and the preview server (not the browser).
VITE_BACKEND_ORIGIN=http://127.0.0.1:8000
