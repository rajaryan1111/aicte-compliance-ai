# Local configuration template — names only, never real values.
#
# The variables below ARE read by the code today (backend/app). Set them only
# in a local, git-ignored `.env` (see .gitignore) or your deployment's secret
# store. Never commit real credentials.

# --- Database (backend/app/db/session.py, backend/alembic/env.py) ---
# SQLite is the built-in dev/test default when unset. PostgreSQL URLs may use
# either postgresql:// or postgres:// — the app normalizes them to the
# installed psycopg2 driver.
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- Authentication (backend/app/core/security.py) ---
# REQUIRED in any running deployment: the JWT signing key must be at least
# 32 characters or token operations raise at runtime.
# JWT_SECRET_KEY=

# --- Private document storage (backend/app/core/storage.py) ---
# Local filesystem directory for private document bytes. Defaults to a
# temporary directory when unset (not durable across restarts).
# STORAGE_LOCAL_DIR=

# --- Malware scanning (backend/app/core/scanner.py) ---
# ClamAV clamd endpoint. When CLAMAV_HOST is unset the scanner falls back to
# a fail-closed quarantine scanner: files never pass the scan gate.
# CLAMAV_HOST=
# CLAMAV_PORT=3310

# --- Background worker broker (backend/app/worker/celery_app.py) ---
# CELERY_BROKER_URL=redis://localhost:6379/0
# REDIS_URL=redis://localhost:6379/0
# Force synchronous in-process task execution (tests only; never set to true
# in a deployment or no work is ever dispatched to the worker).
# CELERY_TASK_ALWAYS_EAGER=false

# --- Planned, not implemented (do not set; nothing reads these) ---
# RETENTION_DAYS=
# DOCUMENT_STORAGE_BUCKET=
