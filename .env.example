# Environment configuration for AICTE Compliance AI Backend
#
# Copy this file to `.env` and fill in real values for local development.
# On Render, configure these in the Environment tab of your Web Service.

# --- Database ---
# PostgreSQL connection string (required for production).
# SQLite fallback is used if unset: sqlite:///./aicte_dev.db
# DATABASE_URL=postgresql://user:password@host:5432/aicte_compliance

# --- Authentication ---
# JWT signing secret key. MUST be at least 32 characters.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# JWT_SECRET_KEY=your-secure-secret-key-at-least-32-chars-long

# --- Background Tasks (Celery) ---
# Redis URL for Celery broker. Required for async document processing.
# CELERY_BROKER_URL=redis://localhost:6379/0
# REDIS_URL=redis://localhost:6379/0
#
# Set to "true" to run Celery tasks synchronously (no Redis needed).
# Recommended for prototype deployments without Redis.
# CELERY_TASK_ALWAYS_EAGER=true

# --- CORS ---
# Additional allowed origin for frontend (beyond hardcoded defaults).
# CORS_ALLOWED_ORIGIN=https://aicte-compliance-frontend.vercel.app

# --- Document Storage ---
# Local filesystem path for private document storage.
# Defaults to system temp directory if unset.
# STORAGE_LOCAL_DIR=/path/to/private/storage

# --- Malware Scanning (Optional) ---
# ClamAV daemon host. If unset, uploads are marked as scan_unavailable
# and kept in quarantine (fail-safe default).
# CLAMAV_HOST=localhost
# CLAMAV_PORT=3310

# --- OCR Engine Tuning (Optional) ---
# TESSERACT_LANGUAGE=eng
# TESSERACT_MAX_BYTES=10485760

# --- Production Safety & Demo Gates ---
# Set ENVIRONMENT to 'production' to automatically disable demo seeding and test endpoints.
ENVIRONMENT=development
ENABLE_DEMO_ENDPOINTS=true

# --- Issuing Authority Integrations ---
# DigiLocker National Document Exchange API credentials.
# Set DIGILOCKER_SANDBOX=true to test mock payload responses locally without live API keys.
# DIGILOCKER_API_KEY=your_digilocker_partner_api_key
# DIGILOCKER_SANDBOX=true

# State Directorate of Fire and Emergency Services portal endpoint.
# STATE_FIRE_PORTAL_URL=https://firenoc.state.gov.in/api/v1/verify

# State Technical Affiliating University NOC portal endpoint.
# UNIVERSITY_PORTAL_URL=https://university.ac.in/api/v1/affiliation-status
