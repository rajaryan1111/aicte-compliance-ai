# Local configuration template — placeholders only, no real values.
#
# Copy to a git-ignored `.env` and fill in locally. NEVER commit a real `.env`,
# a JWT secret, a database password, or an institutional document.
#
# This file previously claimed that no code read any environment variable. That
# is no longer true: the variables below are read today, and leaving them unset
# is what makes the app fall back to defaults. Each entry names the code that
# reads it so this file can be checked against the source.
#
# Convention: "required" means the app misbehaves or refuses to run without it;
# "optional" means a documented default applies (shown as a placeholder below,
# never as a real credential).

# --- Environment detection ----------------------------------------------------
# Read by: backend/app/db/session.py (is_deployed_environment)
# Render sets RENDER=true for every service it runs; APP_ENV/ENVIRONMENT/ENV with
# the value "production" is honoured too. When any of them is set, the SQLite
# default below is REFUSED and the process fails at startup with an actionable
# message — that is the guard against a "healthy" API running on an empty file.
# Leave all of them unset for local development and tests.
# RENDER=
# APP_ENV=

# --- Database -----------------------------------------------------------------
# Read by: backend/app/db/session.py, backend/alembic/env.py
# Required for any non-local run. PostgreSQL is the deployment target; the
# default is a local SQLite file, which is fine for a single-process demo but
# NOT for a multi-worker deployment (SQLite does not handle concurrent writers
# from an API process plus a Celery worker).
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# --- Authentication -----------------------------------------------------------
# Read by: backend/app/core/security.py
# REQUIRED. There is no default: token signing raises RuntimeError without it (or with
# fewer than 32 characters), by design. Generate a high-entropy value (e.g. `python -c "import secrets;
# print(secrets.token_urlsafe(64))"`). Rotating it invalidates existing tokens.
# JWT_SECRET_KEY=

# --- Startup migrations (deployed environments only) --------------------------
# Read by: backend/app/db/migrations.py
# Optional, default "true" when RENDER/APP_ENV marks a deployed environment.
# The app runs `alembic upgrade head` during startup and aborts if it fails, so a
# deploy cannot serve traffic against an unmigrated schema. Set to "false" if you
# run migrations in a release/pre-deploy phase instead (or run several instances,
# where concurrent migrations should be serialised elsewhere).
# MIGRATE_ON_START=true

# --- CORS ---------------------------------------------------------------------
# Read by: backend/app/main.py (_cors_origins)
# Optional. Comma-separated EXACT browser origins allowed to call the API, e.g.
# https://your-frontend.example. Defaults to both deployed frontends (Vercel and
# the Render preview static site) plus the local Vite dev origins. Vercel *preview*
# URLs change per commit and must be listed explicitly; no wildcard or prefix rule
# is accepted, because *.vercel.app names are claimable by anyone. '*' is refused on purpose: this API authenticates with
# a bearer token, so a wildcard would let any site read authenticated responses.
# CORS_ALLOW_ORIGINS=https://aicte-compliance-frontend-preview.onrender.com

# --- Background jobs (Celery) -------------------------------------------------
# Read by: backend/app/worker/celery_app.py
# Required only if the API and the worker run as separate processes/containers.
# A lone API process cannot satisfy the documented "background jobs complete"
# guarantee without a reachable broker plus a running worker.
# CELERY_BROKER_URL takes precedence; REDIS_URL is the fallback.
# REDIS_URL=redis://HOST:6379/0
# CELERY_BROKER_URL=redis://HOST:6379/0
#
# Set to "false" in any deployment that runs a real worker. When unset, the app
# defaults to eager (in-process) execution while pytest is importable, which is
# a test convenience and must never be used to claim a real worker ran a job.
# CELERY_TASK_ALWAYS_EAGER=false
#
# How often a running beat re-dispatches jobs whose retry backoff has elapsed.
# Default 30 seconds. Only active when a beat is running (worker -B, or a
# separate `celery beat` service); without one, retry_wait jobs are never retried.
# RETRY_SWEEP_INTERVAL_SECONDS=30

# --- Malware scanning ---------------------------------------------------------
# Read by: backend/app/core/scanner.py
# Optional. Defaults to 127.0.0.1:3310. If no clamd daemon answers there, uploads
# are NOT treated as clean: the job parks in retry_wait with
# last_error_code=SCANNER_UNAVAILABLE and never reaches "completed". That
# fail-closed behaviour is intentional — do not "fix" it by faking a verdict.
# This is also the reason the real-infrastructure CI job starts a scanner.
# CLAMAV_HOST=127.0.0.1
# CLAMAV_PORT=3310

# --- Private document storage -------------------------------------------------
# Read by: backend/app/core/storage.py
# Optional. Defaults to a local directory. Must point at persistent, writable
# storage in any deployment that survives a restart or a redeploy; the sandbox
# filesystem is not guaranteed to persist. Never point this at a directory
# served directly by the web front end — downloads are authorised per request.
# STORAGE_LOCAL_DIR=/var/lib/aicte-compliance/documents

# --- Frontend -----------------------------------------------------------------
# Read by: frontend/vite.config.ts (VITE_BACKEND_ORIGIN) and
#          frontend/src/api.ts (VITE_API_BASE_URL)
# Optional. Prefer leaving VITE_API_BASE_URL unset so the browser calls the same
# origin and a reverse proxy forwards /api to the backend. There is no CORS
# middleware in the FastAPI app, so serving the front end from a different
# origin than the API requires either a same-origin proxy or an explicit CORS
# change (which is a code change, not a configuration change).
# VITE_BACKEND_ORIGIN=http://127.0.0.1:8000
# VITE_API_BASE_URL=

# --- Planned, NOT implemented -------------------------------------------------
# Do not set these and report the feature as done; nothing reads them yet.
# OIDC_ISSUER=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# DOCUMENT_STORAGE_BACKEND=
# DOCUMENT_STORAGE_BUCKET=
# DOCUMENT_STORAGE_ACCESS_KEY=
# DOCUMENT_STORAGE_SECRET_KEY=
# AUDIT_LOG_BACKEND=
# RETENTION_DAYS=
# TESSERACT_LANGUAGE=eng
# TESSERACT_MAX_BYTES=10485760
